<templates xml:space="preserve">
    <t t-name="mapmedical_website_sale.WebsiteSubcategoryItems">
        <a t-foreach="data"
           t-as="subcategory"
           t-key="data"
           t-attf-href="/shop/category/{{ subcategory['id'] }}"
           class="text-center d-flex justify-content-center align-items-center o_subcategory"
        >
            <t t-out="subcategory['name']"/>
        </a>
    </t>

    <t t-name="mapmedical_website_sale.WebsiteCategoryItems">
        <div t-foreach="data"
             t-as="category"
             t-key="data"
             t-att-data-id="category['id']"
             class="o_category d-flex justify-content-between align-items-center"
        >
            <a t-attf-href="/shop/category/{{ category['id'] }}" t-out="category['name']"/>
            <i class="fa fa-chevron-right" t-if="category['child_ids'].length > 0"/>
        </div>
    </t>

</templates>
