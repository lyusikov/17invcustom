<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='hide_add_to_cart_setting']" position="after">
                <setting id="brands_widget_setting" string="Brands Configuration" help="Configure brands display on the website">
                    <div class="content-group">
                        <div class="row mt16">
                            <label class="o_light_label col-lg-3" string="Brand Filter Limit" for="website_brands_widget_limit"/>
                            <field name="website_brands_widget_limit"/>
                        </div>
                        <div class="row mt16">
                            <label class="o_light_label col-lg-3" string="Brand Mega Menu Limit" for="website_brands_menu_limit"/>
                            <field name="website_brands_menu_limit"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
