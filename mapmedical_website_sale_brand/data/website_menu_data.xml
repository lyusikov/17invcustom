<odoo noupdate="1">
    <record id="menu_brands" model="website.menu">
        <field name="name">Brands</field>
        <field name="url">/brands</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">10</field>
        <field name="is_mega_menu" eval="True"/>
        <field name="mega_menu_classes">mega-menu-brands</field>
        <field name="mega_menu_content" type="html">
            <section class="s_mega_menu_multi_menus py-4 o_colored_level o_cc o_cc1">
                <div class="container">
                    <div class="row" id="brands-mega-menu-content">
                        <div class="col-12 text-center py-4">
                            <i class="fa fa-spinner fa-spin me-2"></i>
                            Loading brands...
                        </div>
                    </div>
                </div>
            </section>
        </field>
    </record>

</odoo>
