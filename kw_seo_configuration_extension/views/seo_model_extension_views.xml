<odoo>
    <record id="view_seo_model_tree_inherit_extension" model="ir.ui.view">
        <field name="name">seo.model.tree.extension</field>
        <field name="model">seo.model</field>
        <field name="inherit_id" ref="kw_seo_configuration.view_seo_model_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="inside">
                <field name="name"/>
                <field name="seo_keywords"/>
                <field name="product_tag_ids" widget="many2many_tags"/>
                <field name="related_products_count"/>
            </xpath>
        </field>
    </record>

    <record id="view_seo_model_form_inherit_extension" model="ir.ui.view">
        <field name="name">seo.model.form.extension</field>
        <field name="model">seo.model</field>
        <field name="inherit_id" ref="kw_seo_configuration.view_seo_model_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="inside">
                <field name="name"/>
                <field name="seo_keywords"/>
            </xpath>
            <xpath expr="//group[2]" position="after">
                <group string="Advanced SEO">
                    <field name="product_tag_ids" widget="many2many_tags"/>
                    <field name="related_products_count" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
